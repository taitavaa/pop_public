class_name BubbleTemplate
extends RefCounted

var color_id: String
var effect_ids: Array[String]
var properties: Array[String]
var payload_id: String
var score_multiplier_bonus: float = 0.0

func _init(
	p_color: String,
	p_effects: Array[String] = [],
	p_properties: Array[String] = [],
	p_payload: String = "standard",
	p_mult: float = 0.0
):
	color_id = p_color
	effect_ids = p_effects
	properties = p_properties
	payload_id = p_payload
	score_multiplier_bonus = p_mult

func get_synergy() -> Dictionary:
	##synergy check
	for synergy_name in GameData.SYNERGIES:
		var synergy = GameData.SYNERGIES[synergy_name]
		var required = synergy["required_effects"]
		
		# Check if ALL required effects exist
		if required.all(func(e): return e in effect_ids):
			return {
				"triggered": true,
				"synergy_name": synergy_name,
				"result_effect": synergy["result_effect"],
				"bonus_multiplier": synergy["bonus_multiplier"],
				"description": synergy["description"]
			}
	
	return {
		"triggered": false,
		"synergy_name": "",
		"result_effect": "",
		"bonus_multiplier": 0.0,
		"description": ""
	}

## Duplicate this template 
func duplicate() -> BubbleTemplate:
	return BubbleTemplate.new(color_id, effect_ids.duplicate(), properties.duplicate(), payload_id, score_multiplier_bonus)
